# Blockmediary — environment template (TRD TR-9.1.3)
# Copy to .env and fill in. Real .env* files are gitignored — never commit secrets.

# Anthropic (Phase 3 — document extraction)
ANTHROPIC_API_KEY=

# WalletConnect / Reown Cloud project (Phase 2 — wallet connect)
NEXT_PUBLIC_WC_PROJECT_ID=

# Which deployment the app talks to: "local" (default), "baseSepolia", or "base".
# "base" = Base Mainnet (real funds) — needs deployments/base.json.
ESCROW_NETWORK=local

# Active chain (primary: Base Sepolia, chainId 84532 — see "Chain selection & failover")
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_PRIVATE_KEY=
BASESCAN_API_KEY=

# Base Mainnet (chainId 8453) — REAL FUNDS. Only needed for the mainnet demo.
# The deploy script uses these; admin and releaser MUST be different keys.
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_MAINNET_PRIVATE_KEY=
BASE_MAINNET_ADMIN_PRIVATE_KEY=

# Off-chain releaser service key (authorises recordVerdict/refund; never custodies funds)
RELEASER_PRIVATE_KEY=

# DANGER: overrides the mainnet releaser-signing block for a CONTROLLED team demo
# only (trivial amounts, throwaway key). Leave UNSET in any real deployment —
# env-var custody is not adequate for production (legal-risk.md §5.4.1).
ALLOW_MAINNET_RELEASE=

# Deployed addresses (filled after Phase 1 deploy)
NEXT_PUBLIC_ESCROW_ADDRESS=
# USDC token. Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Base Mainnet (native USDC): 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
