# Local-only chat logs (per session, written by tools/log_session.py)
.chatlog/

# Local-only Claude Code settings (may contain user-specific permissions / hooks)
.claude

# Per-machine Claude Code settings (may contain user-specific permissions / hooks)
.claude/settings.local.json

# Python
__pycache__/
*.pyc

# Node / Next.js (Phase 2+)
node_modules/
.next/
.pnpm-debug.log
.turbo/

# Env files
.env
.env.local
.env.*.local
!.env.example

# Smart-contract build artefacts (Phase 1+)
contracts/artifacts/
contracts/cache/
contracts/ignition/deployments/
contracts/deployments/*
# ...but the public deployment IS shared: it holds only addresses (no keys), and
# teammates need it to point the app at the same contract. local.json stays out —
# it is regenerated on every `npx hardhat node` and differs per machine.
!contracts/deployments/baseSepolia.json
contracts/typechain-types/

# App runtime data (Phase 3+)
app/data/uploads/
app/data/audit-ledger.jsonl

# OS / editor noise
.DS_Store
Thumbs.db
desktop.ini
BlockMed.code-workspace
.vscode/
.idea/

# MS Office lock/temp files (e.g. ~$Pitch-Deck.pptx) — created while a doc is open
~$*

# Manual point-in-time deck backups (use git history, not sibling files)
proposal/*_backup-*.pptx
