// Blockmediary — persistence for accounts and the escrow's off-chain record.
//
// Replaces the JSON stores (app/data/*.json) with one durable data layer, which
// is what the TRD specs for the full product: a real store for the escrow
// specification, parties and audit ledger rather than files.
//
// What is NOT here, deliberately:
//   • Money and deal STATE live on-chain. This DB never duplicates them — a
//     deal's state is always read from the contract (lib/escrow/chain.ts). We
//     store the on-chain id and the off-chain record that surrounds it.
//   • Wallets. Accounts are wallet-less for now; linking a proven wallet
//     (SIWE) is a later step and needs only a nullable column.
generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts, not here.
datasource db {
  provider = "sqlite"
}

/// A trading company (or staff account). Identity is account-first: an account
/// exists and can act before any wallet is linked — the platform/intermediary
/// case in the BRD's all-party-roles decision.
model Account {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String

  // Company identity. These fields are what KYB/KYB screening (FR-7) will need,
  // so they are captured at signup rather than bolted on later.
  //
  // Field set follows docs/document-templates.md DOC-15 (Certificate of
  // Incorporation). registrationNumber is now REQUIRED: it is the key every
  // other KYB record joins on, and an optional company number makes the rest
  // unverifiable. Existing rows are backfilled with "" by the migration.
  companyName        String
  registrationNumber String
  country            String
  addressLine1       String
  addressLine2       String?
  city               String
  postcode           String

  /// Private limited / public limited / FZ-LLC etc. Drives KYB risk assessment.
  companyType String?
  /// "England and Wales", "DIFC", "ADGM"… — determines the applicable law.
  jurisdiction String?
  /// Companies House, a named UAE free zone registrar, or an EU equivalent.
  issuingAuthority String?
  /// A very recently incorporated company is an AML risk signal (DOC-15).
  incorporationDate DateTime?

  // The individual authorised to bind the company (DOC-18). A contact is not a
  // signatory: only a signatory can commit the company to a deal, and sanctions
  // screening runs against this person, not the company name.
  contactName          String
  signatoryName        String?
  signatoryNationality String?
  signatoryDob         DateTime?
  /// 🚩 FLAG in DOC-18: an expired passport is an automatic hold, not a warning.
  signatoryPassportExpiry DateTime?

  // Self-attested declarations (DOC-19 source of funds). PROOF OF CONCEPT: these
  // are the user's own assertions — nothing here is verified against a registry,
  // a sanctions list, or an uploaded document. They record what the company
  // claims, and when, so the audit trail shows the claim was made and relied on.
  // Production requires screening against OFSI/UN/EU lists at funding AND at
  // release (docs/legal-risk.md), plus Companies House PSC identity verification.
  fundsSourceNature String?
  fundsSourceCountry String?
  /// POCA 2002 / MLR 2017 Sch.2 declarations — both must be affirmed to trade.
  declaredNotCriminalFunds Boolean   @default(false)
  declaredNoSanctions      Boolean   @default(false)
  declarationsAt           DateTime?

  // The wallet this company signs on-chain actions with. Null until linked:
  // identity is account-first, and a platform/intermediary may never link one
  // (they coordinate, they never deposit). Unique so two companies cannot claim
  // the same address — otherwise the contract's per-deal party checks would be
  // ambiguous. Only set after a signature proves ownership (SIWE, EIP-4361);
  // an address alone proves nothing, since anyone can type someone else's.
  walletAddress  String?   @unique
  walletLinkedAt DateTime?

  /// "client" for trading companies; "admin"/"developer" for staff.
  type String @default("client")

  /// Where the company is in onboarding: "incomplete" until the KYB fields and
  /// declarations are supplied, then "attested".
  ///
  /// PROOF OF CONCEPT — "attested" means THE USER SAID SO. There is no reviewer,
  /// no registry lookup, no sanctions screen. The state exists so the structure
  /// is right (a company cannot transact before completing onboarding) and so
  /// the production gate has somewhere to live: a "verified" state set by a
  /// compliance reviewer would slot in alongside these two.
  kybStatus String @default("incomplete")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A deal has exactly two parties; an account can be either on any given deal.
  // Role is a position IN A DEAL, never a property of the account (lib/escrow/roles.ts).
  dealsAsBuyer  Deal[]         @relation("BuyerDeals")
  dealsAsSeller Deal[]         @relation("SellerDeals")
  sessions      Session[]
  auditEntries  AuditEntry[]
  peopleOfControl PersonOfControl[]
}

/// A person with significant control of a company — the beneficial owner
/// (DOC-17). Sanctions screening runs against these individuals, not against the
/// company name, which is why they are recorded separately rather than as fields
/// on Account: a company may have several.
///
/// UK: Companies Act 2006 Part 21A. UAE: Federal Decree-Law No. 20 of 2018.
/// Both set the reporting threshold at 25%.
///
/// PROOF OF CONCEPT — self-declared, unverified. Note what is deliberately NOT
/// stored: no residential address (Companies House holds it but never publishes
/// it), and no full date of birth — month and year only, which is what the
/// public register shows. Collecting less than the regime allows is the right
/// default when none of it is being screened anyway.
model PersonOfControl {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  fullName    String
  nationality String
  /// Month and year only, as on the public PSC register (e.g. "1985-03").
  birthMonthYear String
  countryOfResidence String

  /// Which of the five statutory control conditions applies. Stored as the
  /// condition key ("shares_over_25", "voting_over_25", "appoint_directors",
  /// "significant_influence", "trust_control") — see lib/kyb/psc.ts.
  controlCondition String
  /// Free text for the quantified holding, e.g. "holds 40% of shares".
  controlDetail String?

  createdAt DateTime @default(now())

  @@index([accountId])
}

/// A server-side session. The cookie carries only this row's token; everything
/// authoritative is looked up here, so a session can be revoked server-side.
model Session {
  token     String   @id
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([accountId])
}

/// A one-time challenge for wallet linking (SIWE, EIP-4361).
///
/// The server issues the nonce, the wallet signs a message containing it, and
/// the server verifies the signature recovers to the claimed address. The row is
/// deleted on use, so a captured signature cannot be replayed — which is the
/// whole point of the nonce. Short-lived: unused rows expire.
model WalletNonce {
  nonce     String   @id
  accountId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([accountId])
}

/// Single-row table holding counters that must survive a deal being deleted.
/// dealCounter salts the derived on-chain deal id, so re-running an app deal
/// after a reset never collides with a prior on-chain deal (the contract
/// rejects a duplicate dealId).
model Counter {
  id          Int @id @default(1)
  dealCounter Int @default(0)
}

/// The off-chain half of one escrow deal: the agreed terms (the rulebook the
/// bill of lading is graded against), the parties, and the paper trail. The
/// money and the state machine live on-chain.
model Deal {
  /// The app-level reference shown to users, e.g. "DEAL-4E88-0D57".
  appDealId String @id
  /// bytes32 hex, set once createDeal runs on-chain. Null until accepted.
  onChainDealId String? @unique

  // Agreed terms. Amount is a decimal STRING in USDC units — never a float
  // (AP-5: money math is done in code with bigint, never in floating point).
  goods            String?
  amountUsdc       String?
  sellerName       String?
  buyerName        String?
  shipmentDeadline String?
  /// Optional agreed route/commercial terms — documents are graded against
  /// these when present (docs/document-templates.md DOC-01/02/03).
  portOfLoading    String?
  portOfDischarge  String?
  incoterm         String?

  // Parties. Nullable because a counterparty may be invited before they join —
  // in which case the name is known but there is no account row to point at, so
  // the display names are stored alongside rather than derived from the relation.
  buyerId           String?
  buyer             Account? @relation("BuyerDeals", fields: [buyerId], references: [id])
  buyerDisplayName  String?
  sellerId          String?
  seller            Account? @relation("SellerDeals", fields: [sellerId], references: [id])
  sellerDisplayName String?

  /// Which side proposed it — the OTHER side owes the acceptance.
  createdByRole String?
  /// Set when the counterparty declines. Terminal, off-chain only.
  declinedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review?
  audit  AuditEntry[]

  @@index([buyerId])
  @@index([sellerId])
}

/// Notice of release + objection window (FR-10/11). One per deal, replaced when
/// a corrected bill of lading opens a fresh notice.
model Review {
  dealId String @id
  deal   Deal   @relation(fields: [dealId], references: [appDealId], onDelete: Cascade)

  /// The submitted B/L fields, as graded (JSON — a document snapshot, not queried).
  fieldsJson String
  /// The verdict object incl. per-rule results (JSON — evidence for the trail).
  verdictJson String

  noticeAt     DateTime
  windowEndsAt DateTime
  approvedAt   DateTime?

  // The buyer's objection, if one stands. Cleared on withdrawal; the audit
  // trail keeps the history either way.
  objectionGround    String?
  objectionDetail    String?
  objectionRaisedAt  DateTime?
}

/// Append-only history: who did what, when, and the on-chain proof (FR-14).
/// The regulator-facing artefact — entries are never edited or deleted.
model AuditEntry {
  id     Int    @id @default(autoincrement())
  dealId String
  deal   Deal   @relation(fields: [dealId], references: [appDealId], onDelete: Cascade)

  ts     DateTime @default(now())
  /// "buyer" | "seller" | "platform" | "anyone" — the acting side.
  actor  String
  action String
  detail String?
  txHash String?

  /// The account behind the entry, when known. Kept even if the account is
  /// later removed, so the trail never loses its attribution.
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([dealId, ts])
}
