{\b0 \cf21 \f2 \ri0 \i0 \qj \brdrt \brdrcf32 \brdrw20 \brdrs \fs22 \li0 \brdrb \brdrcf32 \brdrw20 \brdrs 
{\b0 \cf21 \f2 \ul0 \strike0 \i0 \fs22 \sa0 \sb0 
\u160\'3f
